{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"strict": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": ["node"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src"]
}
