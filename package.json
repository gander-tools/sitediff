{
	"name": "sitediff",
	"version": "0.0.0",
	"description": "Given a URL, runs one Playwright (Chromium) pass and captures full page behavior: redirect chain, HAR, rendered DOM, screenshot, and console logs.",
	"license": "AGPL-3.0-or-later",
	"author": {
		"name": "Adam Gąsowski",
		"url": "https://github.com/gander"
	},
	"homepage": "https://github.com/gander-tools/sitediff",
	"bugs": {
		"url": "https://github.com/gander-tools/sitediff/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gander-tools/sitediff.git"
	},
	"keywords": [
		"playwright",
		"chromium",
		"web-capture",
		"har",
		"screenshot",
		"cli"
	],
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0 <25.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11.0.0 <12.0.0",
			"onFail": "error"
		}
	},
	"bin": {
		"sitediff": "dist/sitediff"
	},
	"files": [
		"dist",
		"package.json",
		"LICENSE",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"dev": "tsx src/cli.ts",
		"test": "node --test tests/*.test.ts",
		"test:integration": "node --test tests/integration/*.integration.test.ts",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.1.1",
		"@types/pngjs": "^6.0.5",
		"git-cliff": "^2.13.1",
		"release-it": "^21.0.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@bomb.sh/tab": "^0.0.22",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"commander": "^15.0.0",
		"console-table-printer": "^2.16.1",
		"picocolors": "^1.1.1",
		"pixelmatch": "^8.0.0",
		"playwright": "^1.62.0",
		"pngjs": "^7.0.0",
		"zod": "^4.4.3"
	}
}
